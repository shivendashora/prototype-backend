# Optional. Without a key, the carousel generator uses the built-in template engine.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PostgreSQL connection (the database is created on startup if it doesn't exist)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
